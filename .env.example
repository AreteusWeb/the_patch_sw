# ─── the_patch_sw (frontend) — environment variables ───────────────────────
# Copy this file to .env and fill in the values. NEVER commit your real .env.

# VITE_APP_MODE controls the entire app:
#   local -> no login, no Firebase, no Firestore. The UI connects directly
#            to the-patch-server (with APP_MODE=local as well) and shows
#            ESP32 channels in real time. Ideal for running the project
#            without depending on Areteus credentials/project.
#   cloud (default if omitted) -> requires the VITE_FIREBASE_* variables
VITE_APP_MODE=local

# the-patch-server WebSocket URL. In local mode, your server running on your
# machine (or on the local network where the ESP32 also is):
VITE_WS_URL=ws://localhost:8080/ws
# In cloud mode, the deployed server's public URL, e.g.:
# VITE_WS_URL=wss://chestpad-ws-server-xxxxx.us-central1.run.app/ws

# ─── Only required if VITE_APP_MODE=cloud ──────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
