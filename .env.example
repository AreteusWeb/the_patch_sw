# ─── the_patch_sw (frontend) — environment variables ────────────────────────
# Copy this file to .env and fill in the values. NEVER commit your real .env.
#
# This file is for the Vite app only. The WebSocket server reads
# the-patch-server/.env separately (see that folder's .env.example).

# ─── Mode ───────────────────────────────────────────────────────────────────
# VITE_APP_MODE controls the entire frontend:
#   cloud (default if omitted) -> Firebase Auth + Firestore; needs VITE_FIREBASE_*
#   local                      -> no login / no Firebase. UI talks to a local
#                                 the-patch-server (APP_MODE=local) over WS.
#
# Keep frontend + server modes in sync (both cloud, or both local).
#
# --- Cloud ---
# VITE_APP_MODE=cloud
# VITE_WS_URL=wss://your-cloud-run-host/ws
# + fill all VITE_FIREBASE_* below
#
# --- Local (optional; clone-and-run without Firebase credentials) ---
VITE_APP_MODE=local

# Local-only convenience: skips "My Devices" and shows whatever device is
# streaming. Only works when VITE_APP_MODE=local, AND the backend must also
# have DEV_SHOW_ANY_DEVICE=true (see the-patch-server/.env.example).
VITE_DEV_SHOW_ANY_DEVICE=true

# the-patch-server WebSocket URL.
# Local:
VITE_WS_URL=ws://localhost:8080/ws
# Cloud (deployed server), e.g.:
# VITE_WS_URL=wss://chestpad-ws-server-xxxxx.us-central1.run.app/ws

# Optional HTTP API override (OTA + AI Coach REST).
# In Vite DEV, appConfig defaults to http://localhost:8080 when unset.
# VITE_API_BASE_OVERRIDE=http://localhost:8080
# VITE_API_BASE_OVERRIDE=https://chestpad-ws-server-xxxxx.us-central1.run.app

# ─── Only required if VITE_APP_MODE=cloud ────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Staging / local-cloud ONLY — never set these in production builds ───────
# When both are set (and VITE_APP_MODE=cloud), the app auto sign-inWithEmailAndPassword
# so LoginScreen is skipped. Uses a real Firebase Auth user; backend still verifies
# the idToken. Leave blank/unset in prod so login is required.
# VITE_AUTO_LOGIN_EMAIL=demo@your-domain.test
# VITE_AUTO_LOGIN_PASSWORD=use-a-strong-test-password

