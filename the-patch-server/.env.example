# ─── the-patch-server — environment variables ───────────────────────────────
# Copy this file to .env and fill in the values. NEVER commit your real .env.
#
# The server always loads THIS file (the-patch-server/.env), not the repo-root
# .env used by the Vite frontend.

# ─── Mode ───────────────────────────────────────────────────────────────────
# APP_MODE selects which providers/ wrappers are used:
#   cloud (default if omitted) -> Firebase Auth + Firestore + GCS + Vertex AI
#   local                      -> no Firebase/GCS/Vertex; in-memory DB + disk
#                                 storage + mock AI Coach. No GCP credentials
#                                 required — good for UI / ESP32 channel testing.
#
# --- Cloud (production / real Coach) ---
# APP_MODE=cloud
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GCS bucket for ECG chunks (required in cloud mode)
# GCS_BUCKET_NAME=your-ecg-chunks-bucket
# Optional separate bucket for opt-in AI Coach Voice & Video recordings.
# If unset, recordings fall back to GCS_BUCKET_NAME.
# COACH_RECORDINGS_BUCKET_NAME=your-coach-recordings-bucket
# FIRMWARE_BUCKET_NAME=your-firmware-bucket
# VERTEX_AI_LOCATION=global
# VERTEX_AI_MODEL=gemini-3.6-flash
# Note: Gemini 3.x needs global|us|eu — not us-central1 (404).
# Also run: gcloud auth application-default login   (local cloud-mode only)
#
# --- Local (optional; clone-and-run without Areteus GCP access) ---
APP_MODE=local

PORT=8080

# CORS for browser → REST (/api/coach, /api/ota, /api/devices).
# Comma-separated list ADDED to the hardcoded local defaults
# (http://localhost:3000 and http://192.168.1.72:3000). Echoes the request
# Origin when allowlisted — never uses '*' (incompatible with Authorization).
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://staging.example.com

# Hard cap on coach chat messages per session (user + model turns count).
# Default 40. When reached, POST /api/coach/message returns 429 until a new
# session starts (after the 45-minute idle timeout).
# MAX_MESSAGES_PER_SESSION=40

# ─── Only required if APP_MODE=cloud ───────────────────────────────────────
# If any of these are missing in cloud mode, the server fails on startup
# with a clear message instead of falling back to a default project/bucket.
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET_NAME=
FIRMWARE_BUCKET_NAME=

# Vertex AI (AI Coach / Gemini) — used only when APP_MODE=cloud.
# Uses Application Default Credentials on Cloud Run (same as firebase-admin).
# In APP_MODE=local the coach still responds via a fixed mock (no API quota,
# no credentials) — it will not crash; it just will not call real Gemini.
VERTEX_AI_LOCATION=global
VERTEX_AI_MODEL=gemini-3.6-flash

# Unsplash (AI Coach reference images via search_reference_image tool).
# Hotlink-only: never download/rehost images. Required for cloud coach visuals.
# UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# YouTube Data API (AI Coach exercise tutorials via search_reference_video).
# Create a key with YouTube Data API v3 enabled:
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# YOUTUBE_API_KEY=your-youtube-data-api-key

# Gemini Developer API key — used ONLY for Live API ephemeral tokens
# (POST /api/coach/live-token). Distinct from Vertex AI credentials.
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Optional Live model override (must support Live API / native audio)
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Optional Amazon search host for get_product_search_link (allowlisted).
# Default in code: www.amazon.com.mx (US Amazon often fails / redirects poorly from MX).
# AMAZON_SEARCH_HOST=www.amazon.com
# AMAZON_SEARCH_HOST=www.amazon.com.mx

# ─── Only relevant if APP_MODE=local (optional; defaults already set) ──────
# Folder where ECG chunks and firmware are stored on disk.
# LOCAL_STORAGE_DIR=./local-data/ecg-chunks
# LOCAL_FIRMWARE_DIR=./local-data/firmware
# Opt-in coach Voice & Video recordings (local mode)
# LOCAL_RECORDINGS_DIR=./local-data/coach-recordings

# Local-only convenience: when "true", ignores MAC matching and relays data
# from ANY streaming device to ANY connected web client — no need to
# register/select a device first. Requires APP_MODE=local (no effect in
# cloud mode, for security).
DEV_SHOW_ANY_DEVICE=true
