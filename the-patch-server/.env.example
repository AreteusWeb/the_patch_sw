# ─── the-patch-server — environment variables ───────────────────────────────
# Copy this file to .env and fill in the values. NEVER commit your real .env.
#
# The server always loads THIS file (the-patch-server/.env), not the repo-root
# .env used by the Vite frontend.

# ─── Mode ───────────────────────────────────────────────────────────────────
# APP_MODE selects which providers/ wrappers are used:
#   cloud (default if omitted) -> Firebase Auth + Firestore + GCS + Vertex AI
#   local                      -> no Firebase/GCS/Vertex; in-memory DB + disk
#                                 storage + mock AI Coach. No GCP credentials
#                                 required — good for UI / ESP32 channel testing.
#
# --- Cloud (production / real Coach) ---
# APP_MODE=cloud
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GCS bucket for ECG chunks (required in cloud mode)
# GCS_BUCKET_NAME=your-ecg-chunks-bucket
# Optional separate bucket for opt-in AI Coach Voice & Video recordings.
# If unset, recordings fall back to GCS_BUCKET_NAME.
# COACH_RECORDINGS_BUCKET_NAME=your-coach-recordings-bucket
# FIRMWARE_BUCKET_NAME=your-firmware-bucket
# VERTEX_AI_LOCATION=global
# VERTEX_AI_MODEL=gemini-3.8-flash
# Cheap Flash-Lite for passive sidebar insights (POST /api/coach/insights).
# VERTEX_AI_INSIGHTS_MODEL=gemini-3.1-flash-lite
# Note: Gemini 3.x needs global|us|eu — not us-central1 (404).
# Also run: gcloud auth application-default login   (local cloud-mode only)
#
# --- Local (optional; clone-and-run without Areteus GCP access) ---
APP_MODE=local

PORT=8080

# CORS for browser → REST (/api/coach, /api/ota, /api/devices).
# Comma-separated list ADDED to the hardcoded local defaults
# (http://localhost:3000 and http://192.168.1.72:3000). Echoes the request
# Origin when allowlisted — never uses '*' (incompatible with Authorization).
# CORS_ALLOWED_ORIGINS=https://the-patch-areteus.vercel.app,https://app.areteus.com

# Hard cap on coach chat messages per session (user + model turns count).
# Default 40. When reached, POST /api/coach/message returns 429 until a new
# session starts (after the 45-minute idle timeout).
# MAX_MESSAGES_PER_SESSION=40

# ─── Only required if APP_MODE=cloud ───────────────────────────────────────
# If any of these are missing in cloud mode, the server fails on startup
# with a clear message instead of falling back to a default project/bucket.
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET_NAME=
FIRMWARE_BUCKET_NAME=

# Vertex AI (AI Coach / Gemini) — used only when APP_MODE=cloud.
# Uses Application Default Credentials on Cloud Run (same as firebase-admin).
# In APP_MODE=local the coach still responds via a fixed mock (no API quota,
# no credentials) — it will not crash; it just will not call real Gemini.
VERTEX_AI_LOCATION=global
VERTEX_AI_MODEL=gemini-3.8-flash

# Unsplash (AI Coach reference images via search_reference_image tool).
# Hotlink-only: never download/rehost images. Required for cloud coach visuals.
# UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# YouTube Data API (AI Coach exercise tutorials via search_reference_video).
# Create a key with YouTube Data API v3 enabled:
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# YOUTUBE_API_KEY=your-youtube-data-api-key

# Gemini Developer API key — used ONLY for Live API ephemeral tokens
# (POST /api/coach/live-token). Distinct from Vertex AI credentials.
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Optional Live model override (must support Live API / native audio)
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# ─── Multi-provider LLM layer (llm/) — off by default ──────────────────────
# Feature flag for POST /api/coach/message. When off (default), the coach is
# unchanged. When on, requests with mode='general' are answered by llm.generate()
# with the general-assistant prompt (prompts/general-assistant.cjs); the health
# coach (no mode / mode='coach') keeps the Gemini tool loop.
# COACH_MULTI_PROVIDER=true
# Or enable it only for some Firebase uids (comma-separated), leaving the flag off:
# COACH_MULTI_PROVIDER_UIDS=uid1,uid2
#
# OpenAI — server-side secret ONLY. Never put it in the frontend .env / VITE_*
# vars. On Cloud Run store it in Secret Manager (--update-secrets), not as a
# plain env var.
# OPENAI_API_KEY=
# Model IDs: no defaults on purpose — copy current IDs from OpenAI's model docs.
# 'economy' = cheap tier (mode='general' default), 'mid' = fallback for Gemini mid.
# gpt-6-luna is verified (ID + pricing in llm/config.cjs MODEL_PRICES, Oct 2026).
# OPENAI_MODEL_ECONOMY=gpt-6-luna
# OPENAI_MODEL_MID=
# Per-attempt timeout for llm.generate() in ms (default 45000). One retry on
# 429/5xx/timeout, then fallback to the other provider.
# LLM_TIMEOUT_MS=45000
# Total time budget for one llm.generate() call across the first attempt, the
# retry and the fallback (default 30000). Each attempt is clipped to what's left;
# a timed-out attempt is cancelled. Keep LLM_TIMEOUT_MS well below this (e.g.
# 12000) if you want a hung provider to leave time for the fallback.
# LLM_DEADLINE_MS=30000
# Optional Gemini overrides for the llm/ layer (default: VERTEX_AI_INSIGHTS_MODEL
# for economy, VERTEX_AI_MODEL for mid).
# GEMINI_MODEL_ECONOMY=
# GEMINI_MODEL_MID=
#
# ─── LiteLLM proxy (optional; off by default) ───────────────────────────────
# When LLM_USE_LITELLM=true, llm.generate() calls the proxy first (OpenAI SDK
# against LITELLM_BASE_URL), then falls back to the direct openai/gemini
# adapters on 429 / 5xx / timeout. With the flag off or unset, behavior is
# unchanged (no litellm adapter is registered).
# LLM_USE_LITELLM=true
# LITELLM_BASE_URL=http://localhost:4000/v1
# (If chat/completions 404s, try http://localhost:4000 without /v1.)
# LITELLM_API_KEY=
# Proxy model aliases (must match your LiteLLM model_list / router):
# LITELLM_MODEL_GENERAL_OPENAI=general-openai
# LITELLM_MODEL_GENERAL_GEMINI=general-gemini
# General aiModel=low (DeepSeek via LiteLLM). Off unless DEEPSEEK_ENABLED=true.
# Alias must match the gateway (upstream model is deepseek-v4-flash, not deepseek-chat).
# DEEPSEEK_ENABLED=true
# LITELLM_MODEL_GENERAL_DEEPSEEK=general-deepseek
# Compare script (direct vs proxy, 10 calls each path):
#   set LITELLM_BASE_URL=http://localhost:4000/v1
#   set LITELLM_API_KEY=sk-...
#   set LLM_USE_LITELLM=true
#   node scripts/compare-litellm.cjs

# Optional Amazon search host for get_product_search_link (allowlisted).
# Default in code: www.amazon.com.mx (US Amazon often fails / redirects poorly from MX).
# AMAZON_SEARCH_HOST=www.amazon.com
# AMAZON_SEARCH_HOST=www.amazon.com.mx

# ─── Only relevant if APP_MODE=local (optional; defaults already set) ──────
# Folder where ECG chunks and firmware are stored on disk.
# LOCAL_STORAGE_DIR=./local-data/ecg-chunks
# LOCAL_FIRMWARE_DIR=./local-data/firmware
# Opt-in coach Voice & Video recordings (local mode)
# LOCAL_RECORDINGS_DIR=./local-data/coach-recordings

# Local-only convenience: when "true", ignores MAC matching and relays data
# from ANY streaming device to ANY connected web client — no need to
# register/select a device first. Requires APP_MODE=local (no effect in
# cloud mode, for security).
DEV_SHOW_ANY_DEVICE=true
